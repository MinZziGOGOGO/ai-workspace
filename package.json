{
  "name": "ai-workspace",
  "version": "0.1.0",
  "description": "Local-first AI workspace: Chat | Hermes | Claude Code with shared project-aware knowledge",
  "main": "out/main/index.js",
  "author": "you",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:mcp": "esbuild src/main/mcp/server.ts --bundle --platform=node --format=cjs --target=node18 --external:better-sqlite3 --external:electron --outfile=out/mcp/server.cjs",
    "test:indexer": "esbuild scripts/test-indexer.ts --bundle --platform=node --format=cjs --target=node18 --external:better-sqlite3 --external:chokidar --alias:electron=./scripts/electron-stub.cjs --outfile=out/test/test-indexer.cjs && node out/test/test-indexer.cjs",
    "test:extractor": "esbuild scripts/test-extractor.ts --bundle --platform=node --format=cjs --target=node18 --external:better-sqlite3 --alias:electron=./scripts/electron-stub.cjs --outfile=out/test/test-extractor.cjs && node out/test/test-extractor.cjs",
    "test:knowledge": "esbuild scripts/test-knowledge-quality.ts --bundle --platform=node --format=cjs --target=node18 --external:better-sqlite3 --alias:electron=./scripts/electron-stub.cjs --outfile=out/test/test-knowledge-quality.cjs && powershell -NoProfile -Command \"$env:ELECTRON_RUN_AS_NODE='1'; & .\\node_modules\\.bin\\electron.cmd out\\test\\test-knowledge-quality.cjs\"",
    "test:claudecode": "esbuild scripts/test-claudecode.ts --bundle --platform=node --format=cjs --target=node18 --external:better-sqlite3 --alias:electron=./scripts/electron-stub.cjs --outfile=out/test/test-claudecode.cjs && node out/test/test-claudecode.cjs",
    "test:hermes": "esbuild scripts/test-hermes.ts --bundle --platform=node --format=cjs --target=node18 --external:better-sqlite3 --alias:electron=./scripts/electron-stub.cjs --outfile=out/test/test-hermes.cjs && node out/test/test-hermes.cjs",
    "test:webcompanion": "esbuild scripts/test-web-companion.ts --bundle --platform=node --format=cjs --target=node18 --external:better-sqlite3 --outfile=out/test/test-web-companion.cjs && node out/test/test-web-companion.cjs",
    "test:e2e": "npm run build && playwright test --config=playwright.config.ts",
    "start:win": "powershell -ExecutionPolicy Bypass -File scripts/start.ps1",
    "postinstall": "electron-builder install-app-deps && node scripts/fix-electron.js",
    "pack": "npm run build && npm run build:mcp && electron-builder --win --dir",
    "dist": "npm run build && npm run build:mcp && electron-builder --win",
    "build:installer": "npm run build && npm run build:mcp && electron-builder --win nsis",
    "package": "npm run dist"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "allotment": "^1.20.5",
    "animejs": "4.5.0",
    "better-sqlite3": "^12.11.1",
    "chokidar": "^4.0.3",
    "diff": "^9.0.0",
    "node-pty": "^1.1.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@playwright/test": "^1.49.1",
    "@types/animejs": "^3.1.13",
    "@types/better-sqlite3": "^7.6.13",
    "@types/diff": "^7.0.2",
    "@types/node": "^22.15.0",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.4.1",
    "electron": "^30.5.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.2.0",
    "esbuild": "^0.28.0",
    "playwright": "^1.49.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.8.3",
    "vite": "^5.0.0"
  },
  "build": {
    "appId": "com.you.aiworkspace",
    "productName": "AI Workspace",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/node-pty/**",
      "node_modules/better-sqlite3/**"
    ],
    "electronDist": "node_modules/electron/dist",
    "npmRebuild": false,
    "buildDependenciesFromSource": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-Setup.${ext}",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AI Workspace"
    }
  }
}
